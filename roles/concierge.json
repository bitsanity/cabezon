{
  "include" : "./definitions.json",

  "descrip" :
    "CARP services provided by any Concierge Agent for CABEZON Mall",

  "services": [
    {
      "service": "about",
      "descrip": "Get an introductory text information package about CABEZON",
      "authentication": true,
      "synchronous": false,
      "fee": null,
      "http-request": {
        "method": "POST",
        "url": "/cgi-bin/encrequest",
        "body": {
          "msghex": "<encrypted-message-of-red-request>",
          "sighex": "<ecdsa-signature-of-message>",
          "spkhex": "<signers-EC-public-key>"
        }
      },
      "red-request": {
        "jsonrpc": "2.0",
        "method": "about",
        "params": "[]",
        "id": "<cookie>"
      },
      "http-response": {
        "status": "200 OK"
      },
      "red-async-result": {
        "jsonrpc": "2.0",
        "result" : "<about-CABEZON-text>",
        "id": "<cookie>"
      }
    },

    {
      "service": "roles",
      "descrip": "Retrieve CABEZON role names and brief descriptions",
      "authentication": true,
      "synchronous": false,
      "fee": null,
      "http-request": {
        "method": "POST",
        "url": "/cgi-bin/encrequest",
        "body": {
          "msghex": "<encrypted-message-of-red-request>",
          "sighex": "<ecdsa-signature-of-message>",
          "spkhex": "<signers-EC-public-key>"
        }
      },
      "red-request": {
        "jsonrpc": "2.0",
        "method": "roles",
        "params": "[]",
        "id": "<cookie>"
      },
      "http-response": {
        "status": "200 OK"
      },
      "red-async-result": {
        "jsonrpc": "2.0",
        "result": [
          {
            "role": "<cabezon-role-name>",
            "descrip": "<role-brief-description-text>"
          }
        ],
        "id": "<cookie>"
      }
    },

    {
      "service": "agents",
      "descrip": "Retrieve SADs of CABEZON agents by <cabezon-role-name>, or the full directory if params is empty",
      "authentication": true,
      "synchronous": false,
      "fee": null,

      "http-request": {
        "method": "POST",
        "url": "/cgi-bin/encrequest",
        "body": {
          "msghex": "<encrypted-message-of-red-request>",
          "sighex": "<ecdsa-signature-of-message>",
          "spkhex": "<signers-EC-public-key>"
        }
      },
      "red-request": {
        "jsonrpc": "2.0",
        "method": "agents",
        "params": [ "<cabezon-role-name>" ],
        "id": "<cookie>"
      },
      "http-response": {
        "status": "200 OK"
      },
      "red-async-result": {
        "jsonrpc": "2.0",
        "result" : {
          "<cabezon-role-name>" : [ "SADs" ]
        },
        "id": "<client-cookie>"
      }
    },

    {
      "service": "join",
      "descrip":
        "Apply for membership in CABEZON Mall. Initial fee, monthly rent",
      "authentication": true,
      "synchronous": false,
      "fee": {
        "amt": "0.1 eth",
        "to": "0x...address",
        "network": "Ethereum"
      },
      "http-request": {
        "method": "POST",
        "url": "/cgi-bin/encrequest",
        "body": {
          "msghex": "<encrypted-message-of-red-request>",
          "sighex": "<ecdsa-signature-of-message>",
          "spkhex": "<signers-EC-public-key>"
        }
      },
      "red-request": {
        "jsonrpc": "2.0",
        "method": "join",
        "params": [ "<cabezon-role-name>" ],
        "id": "<ethereum-transaction-hash-from-fee>"
      },
      "http-response": {
        "status": "200 OK"
      },
      "red-async-result": {
        "jsonrpc": "2.0",
        "result" : "<rental-agreement>",
        "id": "<client-cookie>"
      }
    },

    {
      "service": "rent",
      "descrip":
      "Agents pay monthly in their choice of currency that Concierge accepts",
      "authentication": true,
      "synchronous": false,
      "fee": [
        {
          "amt": "0.001 ether",
          "to": "<ethereum-address>",
          "network": "Ethereum"
        },
        {
          "amt": "0.001 ether",
          "to": "<arbitrum-address>",
          "network": "Arbitrum"
        },
        {
          "amt": "0.025 SOL",
          "to": "<solana-address>",
          "network": "Solana"
        }
      ],
      "http-request": {
        "method": "POST",
        "url": "/cgi-bin/encrequest",
        "body": {
          "msghex": "<encrypted-message-of-red-request>",
          "sighex": "<ecdsa-signature-of-message>",
          "spkhex": "<signers-EC-public-key>"
        }
      },
      "red-request": {
        "jsonrpc": "2.0",
        "method": "rent",
        "params": [],
        "id": "<fee+rent-payment-transaction-hash>"
      },
      "http-response": {
        "status": "200 OK"
      },
      "red-async-result": {
        "jsonrpc": "2.0",
        "result" : "<cabezon-rent-receipt>",
        "id": "<fee+rent-payment-transaction-hash>"
      }
    }
  ]

}
