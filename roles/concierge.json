{
  "include" : "./definitions.json",

  "descrip" :
    "CARP services provided by any Concierge Agent for CABEZON Mall",

  "services": [
    {
      "service": "about",
      "descrip": "Get an introductory text information package about CABEZON",
      "authentication": true,
      "synchronous": false,
      "fee": null,
      "http-request": {
        "method": "POST",
        "url": "/cgi-bin/encrequest",
        "body": {
          "msghex": "<encrypted-message-of-red-request>",
          "sighex": "<ecdsa-signature-of-message>",
          "spkhex": "<signers-EC-public-key>"
        }
      },
      "red-request": {
        "jsonrpc": "2.0",
        "method": "about",
        "params": "[]",
        "id": "<cookie>"
      },
      "http-response": {
        "status": "200 OK"
      },
      "red-async-result": {
        "jsonrpc": "2.0",
        "result" : "<about-CABEZON-text>",
        "id": "<cookie>"
      }
    },

    {
      "service": "agents",
      "descrip": "Retrieve SADs of CABEZON agents by <cabezon-role-name>",
      "authentication": true,
      "synchronous": false,
      "fee": null,

      "http-request": {
        "method": "POST",
        "url": "/cgi-bin/encrequest",
        "body": {
          "msghex": "<encrypted-message-of-red-request>",
          "sighex": "<ecdsa-signature-of-message>",
          "spkhex": "<signers-EC-public-key>"
        }
      },
      "red-request": {
        "jsonrpc": "2.0",
        "method": "agents",
        "params": [ "<cabezon-role-name>" ],
        "id": "<cookie>"
      },
      "http-response": {
        "status": "200 OK"
      },
      "red-async-result": {
        "jsonrpc": "2.0",
        "result" : "[ SAD, ... ]",
        "id": "<client-cookie>"
      }
    },

    {
      "service": "rent",
      "descrip":
      "Agents pay monthly in their choice of currency that Concierge accepts",
      "authentication": true,
      "synchronous": false,
      "fee": [
        {
          "amt": "0.001 ether",
          "to": "<ethereum-address>",
          "network": "Ethereum"
        },
        {
          "amt": "0.001 ether",
          "to": "<arbitrum-address>",
          "network": "Arbitrum"
        },
        {
          "amt": "0.025 SOL",
          "to": "<solana-address>",
          "network": "Solana"
        }
      ],
      "http-request": {
        "method": "POST",
        "url": "/cgi-bin/encrequest",
        "body": {
          "msghex": "<encrypted-message-of-red-request>",
          "sighex": "<ecdsa-signature-of-message>",
          "spkhex": "<signers-EC-public-key>"
        }
      },
      "red-request": {
        "jsonrpc": "2.0",
        "method": "rent",
        "params": [],
        "id": "<fee+rent-payment-transaction-hash>"
      },
      "http-response": {
        "status": "200 OK"
      },
      "red-async-result": {
        "jsonrpc": "2.0",
        "result" : "<cabezon-rent-receipt>",
        "id": "<fee+rent-payment-transaction-hash>"
      }
    }
  ]

}
